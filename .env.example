# Copy to .env (or set as environment variables). Keys are needed for the
# api layer only — the free layer (/web_change free) runs keyless Exa MCP.

# Tavily (recommended, best quality) — https://tavily.com (1000 free credits/mo)
PI_SEARCH_TAVILY_KEY=

# Exa (semantic search) — https://exa.ai
PI_SEARCH_EXA_KEY=

# Brave (keyword search) — https://brave.com/search/api/
PI_SEARCH_BRAVE_KEY=

# Search cache TTL in seconds (default 21600 = 6h)
# PI_SEARCH_CACHE_TTL=21600

# Page cache TTL in seconds (default 86400 = 24h)
# PI_SEARCH_PAGE_TTL=86400
